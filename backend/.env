# SkillSetu AI — Backend Environment Configuration
# Copy this to .env and fill in real values for production

# ── Application ───────────────────────────────────────────
SECRET_KEY=skillsetu_sih_super_secure_jwt_secret_key_2026_change_in_production
PROJECT_NAME=SkillSetu AI

# ── Database ──────────────────────────────────────────────
# SQLite (default, zero-config for local dev)
DATABASE_URL=sqlite:///./skillsetu.db

# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql://skillsetu_user:your_password@localhost:5432/skillsetu_db

# ── Demand Index Weights (must sum to 1.0) ────────────────
DEMAND_WEIGHT_JOB_POSTINGS=0.35
DEMAND_WEIGHT_HIRING_GROWTH=0.25
DEMAND_WEIGHT_SECTOR_GVA_GROWTH=0.20
DEMAND_WEIGHT_INVESTMENT_INFLOWS=0.20

# ── Supply Index Weights (must sum to 1.0) ────────────────
SUPPLY_WEIGHT_SANCTIONED_SEATS=0.30
SUPPLY_WEIGHT_ENROLMENTS=0.35
SUPPLY_WEIGHT_COMPLETIONS_PASSOUTS=0.35

# ── Gap Classification Thresholds ─────────────────────────
SHORTAGE_THRESHOLD=0.15
OVERSUPPLY_THRESHOLD=-0.15
